# 复制为 .env 后填入真实值（不要提交 .env）

# ===== 鉴权模式 =====
# 部署在微信云托管 + 开启「开放接口服务」时：留空下面两项即可，
# relay 自动走云调用模式（容器内 HTTP 请求 api.weixin.qq.com，平台注入鉴权，无需 token）。
# 本地调试 / 其它平台部署：填下面两项，relay 用它们换 access_token（需把出口 IP 加白名单）。
WX_APPID=
WX_APPSECRET=
# 显式强制云调用模式（可选；默认按是否填了 appid/secret 自动判断）
# WX_CLOUDCALL=1

# ===== relay 自身访问密钥（必填，保护公网接口）=====
# 云托管默认公网访问地址是平台生成的地址，任何人可访问，务必设强密钥。
# 客户端调用 /material 或 /draft 时带请求头：X-API-Key: <这里的值>
RELAY_API_KEY=change-me

# 草稿作者署名（可选）
DEFAULT_AUTHOR=多彩生活技术人生

# 监听端口（云托管读取此处端口）
PORT=8000
